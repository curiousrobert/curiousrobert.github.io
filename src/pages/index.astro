<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>curiousrobert | Brand Systems &amp; Motion</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --studio-bg: #fcfcff;       /* Pure gallery white canvas */
  --studio-ink: #080808;      /* Deep obsidian type */
  --studio-muted: #6E6E6E;    /* Technical data / secondary text */
  --studio-line: #E2E2E2;     /* Architectural hairline grid lines */
  --studio-accent: #0038FF;   /* International Klein Blue */
}

html {
  scroll-behavior: smooth;
}

html, body {
  font-family: 'Space Mono', monospace;
  background: var(--studio-bg);
  color: var(--studio-ink);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ── NAV (Sticky Glassmorphism) ───────────────────── */

nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 2.5rem;
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(252, 252, 255, 0.80);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--studio-line);
  transition: all 0.3s ease;
}

.nav-name {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--studio-ink);
  text-decoration: none;
}

.nav-links {
  display: flex;
  gap: 2.5rem;
}

.nav-links a {
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--studio-muted);
  text-decoration: none;
  transition: color 0.3s ease;
}

.nav-links a:hover { color: var(--studio-ink); }

/* ── HEADER (Balanced Spacing & Clean Vibe) ───────── */

.header {
  padding: 4.5rem 2.5rem 4rem; 
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;        
  gap: 2rem;
}

.header-title {
  font-size: clamp(2.8rem, 7.2vw, 6.2rem); 
  font-weight: 700;
  letter-spacing: -0.04em;   /* Compressed structural monospace look */
  line-height: 0.95;          
  color: var(--studio-ink);
  text-transform: uppercase;
}

.header-title span {
  color: var(--studio-accent); 
  display: block;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rem;
  padding-bottom: 0.5rem;
}

.header-sub {
  font-size: 0.65rem;
  font-weight: 400;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--studio-muted);
  text-align: right;
  line-height: 1.8;
}

.header-count {
  font-size: 0.95rem; 
  font-weight: 700;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  color: var(--studio-ink);
  line-height: 1;
}

/* ── THE STUDIO GRID (Architectural Hairlines) ────── */

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--studio-line); 
  gap: 1px; 
  border-top: 1px solid var(--studio-line);
  border-bottom: 1px solid var(--studio-line);
}

/* ── PROJECT COMPONENTS ───────────────────────────── */

.project {
  display: block;
  text-decoration: none;
  color: inherit;
  position: relative;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: #fcfcff;
}

.project video,
.project img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transform: scale(1.01);
  transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.project:hover video,
.project:hover img {
  transform: scale(1.05);
}

.project--soon video {
  filter: grayscale(100%) brightness(0.4);
}

.project-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(8,8,8,0.9) 0%, rgba(8,8,8,0) 60%);
  opacity: 0.6;
  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
  z-index: 2;
}

.project:hover .project-overlay {
  opacity: 0.85;
}

/* Bottom Information Label */
.project-label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 2.5rem;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 1rem;
  z-index: 5;
  transform: translateY(0);
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}

.project:hover .project-label {
  transform: translateY(-5px);
}

.project-name {
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: #fcfcff;
  line-height: 1.0;
  text-transform: uppercase;
}

.project-right {
  text-align: right;
  flex-shrink: 0;
  max-width: 48%;
}

.project-cat {
  display: block;
  font-size: 0.6rem; 
  font-weight: 400;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  line-height: 1.6;
}

.project-year {
  display: block;
  font-size: 0.6rem;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: rgba(255,255,255,0.35);
  margin-top: 0.2rem;
}

/* Technical Electric Blue Subtitle Badge */
.project-num {
  position: absolute;
  top: 1.75rem;
  left: 2.5rem;
  z-index: 10;
  
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--studio-accent);
  
  background-color: var(--studio-ink);
  padding: 0.4rem 0.8rem;
  border-radius: 0px; 
  text-transform: uppercase;
  
  border-left: 3px solid var(--studio-accent);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

/* Soon Badge */
.project-soon {
  position: absolute;
  top: 1.75rem;
  right: 2.5rem;
  z-index: 10;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #FFFFFF;
  background: rgba(8, 8, 8, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 0.4rem 0.8rem;
  border-radius: 0px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

/* ── FOOTER ──────────────────────────────────────── */

footer {
  padding: 4rem 2.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--studio-ink);
  color: #FFFFFF;
}

footer p, footer a {
  font-size: 0.65rem;
  font-weight: 400;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  text-decoration: none;
  transition: color 0.3s ease;
}

footer a:hover { color: #FFFFFF; }

/* ── RESPONSIVE STUDIO SYSTEM ─────────────────────── */

@media (max-width: 900px) {
  .header {
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 4rem 2rem 3rem;
  }
  .header-right {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
  }
  .header-sub { text-align: left; }
  .header-count { text-align: right; }
  nav { padding: 1.25rem 2rem; }
  .project-label { padding: 1.75rem 2rem; }
  .project-num { top: 1.5rem; left: 2rem; }
  .project-soon { top: 1.5rem; right: 2rem; }
}

@media (max-width: 600px) {
  nav { padding: 1rem 1.25rem; }
  nav .nav-links { gap: 1.5rem; }

  .header {
    padding: 3.5rem 1.25rem 2.5rem;
  }

  .header-title {
    font-size: clamp(2.0rem, 11vw, 3.8rem);
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .project {
    aspect-ratio: 4/5; 
  }

  .project:hover video,
  .project:hover img {
    transform: scale(1.02);
  }

  .project-label {
    padding: 1.5rem 1.25rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }
  
  .project:hover .project-label {
    transform: translateY(0);
  }

  .project-right { 
    max-width: 100%; 
    text-align: left;
  }

  .project-num { top: 1.25rem; left: 1.25rem; font-size: 0.85rem; }
  .project-soon { top: 1.25rem; right: 1.25rem; }

  footer {
    padding: 3rem 1.25rem;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
}

</style>
</head>
