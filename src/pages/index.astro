---
import Layout from '../layouts/Layout.astro';
---

<Layout title="curiousrobert — Systems in Motion">
  
  <nav class="w-full px-6 md:px-10 py-6 flex justify-between items-center bg-[#fcfcff]/90 backdrop-blur-md sticky top-0 z-50">
    <div class="flex flex-col">
      <a href="/" class="text-[1 rem] font-bold font-mono tracking-wider uppercase text-[#080808] no-underline transition-opacity hover:opacity-50">
        curiousrobert 🎈
      </a>
    </div>

    <div class="flex gap-8 md:gap-12 font-mono text-[0.65rem] font-medium tracking-widest uppercase">
      <a href="/" class="text-[#080808] border-b border-[#080808] pb-0.5 no-underline">Home</a>
      <a href="/about" class="text-[#888888] hover:text-[#080808] transition-colors no-underline">About</a>
      <a href="mailto:curiousrobertmail@gmail.com" class="text-[#888888] hover:text-[#080808] transition-colors no-underline">Contact</a>
    </div>
  </nav>

  <main class="w-full pb-0 bg-[#fcfcff]">
    
    <header class="px-6 md:px-10 max-w-[1800px] mx-auto pt-16 md:pt-28 mb-24 md:mb-44 grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
      <div class="lg:col-span-8">
        <h1 class="font-sans font-bold text-[15vw] md:text-[9.5vw] leading-[0.8] tracking-tighter uppercase text-[#080808] reveal-up m-0 origin-left">
          Systems<br/><span class="text-[#0038FF]">and motion</span>
        </h1>
      </div>
      <div class="lg:col-span-4 flex flex-col items-start lg:items-end font-mono text-[10px] md:text-xs uppercase tracking-[0.15em] text-[#6E6E6E] reveal-up space-y-4 lg:text-right">
        <p class="leading-relaxed">
          Brand & Motion Designer<br/>Bucharest // Working Globally<br/>2024 — 2026
        </p>
        <span class="text-[#080808] font-bold tracking-widest block pt-4">Selected Case Studies [04]</span>
      </div>
    </header>

    <section class="px-6 md:px-10 max-w-[1800px] mx-auto pb-40">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-x-10 md:gap-y-20">
        
        <div class="md:col-span-7 reveal-up">
          <a href="" class="group block no-underline opacity-50 hover:opacity-100 transition-all duration-700 ease-out">
            <div class="video-container w-full aspect-[4/3] overflow-hidden bg-[#fcfcff] mb-6 relative grayscale">
              <video 
                src="/videos/visit-bucharest.mp4" 
                autoplay 
                muted 
                loop 
                playsinline 
                class="w-full h-full object-cover"
              ></video>
              <div class="absolute top-4 right-4 font-mono text-[12px] tracking-widest uppercase bg-[#080808] text-white px-2 py-1">
                Soon
              </div>
            </div>
            <div class="flex justify-between items-start gap-4">
              <div>
                <h2 class="font-sans font-bold text-2xl md:text-3xl uppercase tracking-tight text-[#080808] mb-1">
                  Bucharest in Motion
                </h2>
                <p class="font-mono text-[10px] md:text-xs uppercase tracking-wider text-[#6E6E6E]">
                  Typographic Identity & Motion
                </p>
              </div>
              <div class="font-mono text-xs text-right text-[#6E6E6E] pt-1">
                <span class="block font-bold text-[#080808]">01</span>
                <span class="block text-[10px] opacity-60">2026</span>
              </div>
            </div>
          </a>
        </div>

        <div class="md:col-span-5 md:mt-32 reveal-up">
          <a href="/projects/drip" class="group block no-underline">
            <div class="video-container w-full aspect-[4/5] md:aspect-[3/4] overflow-hidden bg-[#fcfcff] mb-6">
              <video 
                src="/videos/drip-video-2.mp4" 
                autoplay 
                muted 
                loop 
                playsinline 
                class="w-full h-full object-cover"
              ></video>
            </div>
            <div class="flex justify-between items-start gap-4">
              <div>
                <h2 class="font-sans font-bold text-2xl md:text-3xl uppercase tracking-tight text-[#080808] mb-1 group-hover:text-[#0038FF] transition-colors">
                  Drip Soda
                </h2>
                <p class="font-mono text-[10px] md:text-xs uppercase tracking-wider text-[#6E6E6E]">
                  Brand Identity & Motion
                </p>
              </div>
              <div class="font-mono text-xs text-right text-[#6E6E6E] pt-1">
                <span class="block font-bold text-[#080808]">02</span>
                <span class="block text-[10px] opacity-60">2026</span>
              </div>
            </div>
          </a>
        </div>

        <div class="md:col-span-5 reveal-up">
          <a href="" class="group block no-underline opacity-50 hover:opacity-100 transition-all duration-700 ease-out">
            <div class="video-container w-full aspect-[8/8] overflow-hidden bg-[#fcfcff] mb-6 relative grayscale">
              <video 
                src="/videos/semn-video-4.mp4" 
                autoplay 
                muted 
                loop 
                playsinline 
                class="w-full h-full object-cover"
              ></video>
              <div class="absolute top-4 right-4 font-mono text-[12px] tracking-widest uppercase bg-[#080808] text-white px-2 py-1">
                Soon
              </div>
            </div>
            <div class="flex justify-between items-start gap-4">
              <div>
                <h2 class="font-sans font-bold text-2xl md:text-3xl uppercase tracking-tight text-[#080808] mb-1">
                  Semn
                </h2>
                <p class="font-mono text-[10px] md:text-xs uppercase tracking-wider text-[#6E6E6E]">
                  Brand Identity & Motion
                </p>
              </div>
              <div class="font-mono text-xs text-right text-[#6E6E6E] pt-1">
                <span class="block font-bold text-[#080808]">01</span>
                <span class="block text-[10px] opacity-60">2026</span>
              </div>
            </div>
          </a>
        </div>

        <div class="md:col-span-7 md:-mt-16 reveal-up">
          <a href="/projects/promptlab" class="group block no-underline">
            <div class="video-container w-full aspect-[16/10] md:aspect-[4/3] overflow-hidden bg-[#fcfcff] mb-6">
              <video 
                src="/videos/promptlab-video-2.mp4" 
                autoplay 
                muted 
                loop 
                playsinline 
                class="w-full h-full object-cover"
              ></video>
            </div>
            <div class="flex justify-between items-start gap-4">
              <div>
                <h2 class="font-sans font-bold text-2xl md:text-3xl uppercase tracking-tight text-[#080808] mb-1 group-hover:text-[#0038FF] transition-colors">
                  Promptlab.io
                </h2>
                <p class="font-mono text-[10px] md:text-xs uppercase tracking-wider text-[#6E6E6E]">
                  Identity, Motion & Digital Product
                </p>
              </div>
              <div class="font-mono text-xs text-right text-[#6E6E6E] pt-1">
                <span class="block font-bold text-[#080808]">04</span>
                <span class="block text-[10px] opacity-60">2025</span>
              </div>
            </div>
          </a>
        </div>

      </div>
    </section>

    <footer class="w-full bg-[#080808] px-6 md:px-10 py-16">
      <div class="max-w-[1800px] mx-auto flex flex-col gap-8 md:flex-row justify-between items-start md:items-center font-mono text-[10px] md:text-xs uppercase tracking-widest text-[#888888]">
        <p class="m-0">© Curious Robert 2026</p>
        <p class="m-0 md:absolute md:left-1/2 md:-translate-x-1/2">Bucharest / Global</p>
        <button onclick="window.scrollTo({top:0,behavior:'smooth'});" class="bg-transparent border-none text-[#fcfcff] hover:opacity-70 transition-opacity cursor-pointer font-mono p-0 text-[10px] md:text-xs uppercase tracking-widest">
          Back to top <span class="ml-1">↑</span>
        </button>
      </div>
    </footer>

  </main>
</Layout>

<style>
  /* Premium Studio Animation Curves */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    will-change: transform, opacity; 
    transition: opacity 1.4s cubic-bezier(0.215, 0.610, 0.355, 1), 
                transform 1.4s cubic-bezier(0.215, 0.610, 0.355, 1);
  }
  
  .reveal-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Structural lock on video parent wrapper */
  .video-container {
    isolation: isolate;
    contain: paint;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(0);
  }

  /* Explicit native 3D Matrix lock to maintain uninterrupted hardware layers */
  .video-container video {
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translate3d(0, 0, 0) scale(1.01);
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    transition: transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .group:hover .video-container video {
    transform: translate3d(0, 0, 0) scale(1.04);
  }

  ::selection {
    background: #0038FF;
    color: #fcfcff;
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { 
    threshold: 0.05,
    rootMargin: "0px 0px -20px 0px" 
  });

  document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
</script>