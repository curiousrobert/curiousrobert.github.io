---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profilePic from '../assets/profile_pic.png';
---

<Layout title="about.curiousrobert">
  
  <nav class="w-full px-6 py-6 md:px-12 md:py-8 flex flex-col items-start gap-4 md:flex-row md:justify-between md:items-start mix-blend-difference text-[#F2F2F2]">
    <div class="flex flex-col">
      <a href="/" class="text-2xl font-normal tracking-widest leading-none hover:opacity-50 transition">
        curiousrobert<br/>
      </a>
      <span class="font-mono text-[10px] mt-2 opacity-60 hidden md:block">
        2026 // Bucharest
      </span>
    </div>

    <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[10px] sm:text-xs font-bold tracking-widest uppercase">
      <a href="/" class="opacity-50 hover:opacity-100 transition-opacity">Home</a>
      <a href="/about" class="border-b border-white pb-0.5">About</a> 
      <a href="mailto:curiousrobertmail@gmail.com" class="opacity-50 hover:opacity-100 transition-opacity">Contact</a>
    </div>
  </nav>

  <main class="w-full max-w-[1400px] mx-auto pt-12 md:pt-16 px-6 md:px-12 pb-24">

    <section class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24">
      
      <aside class="md:col-span-4 relative">
        <div class="md:sticky md:top-32 space-y-12 reveal-up">
          
          <div class="w-full bg-transparent overflow-hidden relative grayscale hover:grayscale-0 transition duration-700">
             <Image
               src={profilePic}
               alt="Portrait"
               width={1200}
               height={1202}
               widths={[320, 480, 640, 800, 1200]}
               sizes="(min-width: 768px) 33vw, 90vw"
               loading="lazy"
               decoding="async"
               class="w-full h-auto object-cover"
             />
          </div>

        </div>
      </aside>

      <article class="md:col-span-8 space-y-16 md:space-y-24">
        
        <div class="reveal-up">
          <h2 class="text-3xl md:text-4xl font-bold italic tracking-tight text-black mb-8">About</h2>
          <div class="space-y-8 text-xl md:text-2xl font-semibold leading-relaxed text-[#111] max-w-3xl">
            <p>
              Hi! My name is Marin Robert, an aspiring Brand & Motion Designer with a toolkit full of creativity, multidisciplinary tools and a passion for crafting unique visual identities.
            </p>
            <p>
             I aspire in helping little and big brands alike to communicate their values and stories through compelling design solutions that leave a lasting impact.
            </p>
          </div>
        </div>

        <div class="reveal-up">
            <h2 class="text-3xl md:text-4xl font-bold italic tracking-tight text-black mb-8">Toolkit</h2>
            <div class="flex flex-wrap gap-4">
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">After Effects</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">Cavalry</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">Blender 3D</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">Figma</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">DaVinci Resolve</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">Affinity</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">Illustrator</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">Photoshop</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">Jitter</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">Ableton</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">CSS</span>
                <span class="px-4 py-2 border border-black rounded-full font-mono text-sm uppercase font-bold hover:bg-black hover:text-white transition">HTML</span>
            </div>
        </div>

      </article>

    </section>

    <footer class="mt-24 md:mt-48 px-6 md:px-12 py-12 border-t border-black/10 reveal-up">
        <div class="flex flex-col md:flex-row justify-between items-center font-mono text-[10px] uppercase tracking-widest text-gray-500">
         <p>© Curious Robert 2026</p>
         <p>Bucharest / Romania</p>
         <div class="flex gap-6 mt-4 md:mt-0">
             <a href="#" class="hover:text-black transition"></a>
             <a href="#" class="hover:text-black transition"></a>
             <a href="#" class="hover:text-black transition"></a>
         </div>
       </div>
    </footer>

  </main>
</Layout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
</script>
