---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profilePic from '../assets/profile_pic.png';
---

<Layout title="Info — curiousrobert">
  
  <nav transition:name="site-nav" class="w-full px-5 md:px-10 py-5 flex flex-col md:flex-row justify-between items-start md:items-center bg-[#F8F8F8]/90 backdrop-blur-md sticky top-0 z-50 border-b-2 border-[#0D0D0D] gap-5 md:gap-0">
    <!-- Cleaned up flex container -->
    <div class="flex items-center w-full md:w-auto">
      <a href="/" class="group text-lg md:text-[1.1rem] font-black font-primary tracking-widest uppercase text-[#0D0D0D] no-underline flex items-center gap-2 w-fit">
        curiousrobert 
        <span class="text-sm font-light text-[#0004ff] group-hover:rotate-90 transition-transform duration-300">✦</span>
      </a>
    </div>

    <div class="flex flex-wrap gap-4 md:gap-12 font-primary text-[10px] md:text-[11px] font-bold tracking-[0.15em] uppercase w-full md:w-auto justify-start md:justify-end">
      <a href="/" class="text-[#0D0D0D] hover:text-[#0004ff] py-1.5 transition-colors no-underline w-fit">Home</a>
      <a href="/about" class="text-[#F8F8F8] bg-[#0004ff] px-3 py-1.5 border-2 border-[#0D0D0D] shadow-[2px_2px_0px_0px_#0D0D0D] hover:translate-y-[2px] hover:shadow-none transition-all no-underline w-fit">Info</a>
      <a href="mailto:curiousrobertmail@gmail.com" class="text-[#0D0D0D] hover:text-[#0004ff] py-1.5 transition-colors no-underline w-fit">Contact</a>
    </div>
  </nav>

  <main class="w-full pb-0 bg-transparent">
    
      
      <div class="lg:col-span-4 flex flex-col items-start lg:items-end font-primary text-[10px] md:text-[11px] uppercase tracking-[0.15em] text-[#0D0D0D] space-y-6 lg:text-right">
        <p class="leading-relaxed font-semibold opacity-0 hero-fade border-l-2 lg:border-l-0 lg:border-r-2 border-[#0004ff] pl-4 lg:pl-0 lg:pr-4 w-fit" style="--delay: 0.6s">
          Marin Robert<br/>Bucharest // Global<br/>Est. 2024
        </p>
      </div>
    </header>

    <section class="px-5 md:px-10 max-w-[1800px] mx-auto pb-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
        <aside class="lg:col-span-5 relative">
          <div class="lg:sticky lg:top-32 reveal-up">
            <div class="w-full aspect-[4/5] bg-[#e0e0e0] overflow-hidden relative border-2 border-[#0D0D0D] transition-all duration-300 hover:shadow-[8px_8px_0px_0px_#0004ff] group">
              <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4xNSIvPjwvc3ZnPg==')] opacity-0 group-hover:opacity-100 z-30 transition-opacity duration-300 pointer-events-none mix-blend-overlay"></div>
              <Image src={profilePic} alt="Marin Robert - Portrait" width={1200} height={1500} class="absolute inset-0 w-full h-full object-cover grayscale z-20 transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:scale-105" />
            </div>
            <div class="mt-4 flex justify-between font-primary text-[10px] md:text-[11px] uppercase tracking-[0.15em] text-[#0D0D0D] font-bold">
              <span>Marin Robert</span>
              <span class="text-[#0004ff] italic font-light lowercase">Bucharest, RO</span>
            </div>
          </div>
        </aside>

        <article class="lg:col-span-7 space-y-16 md:space-y-24 pt-4 md:pt-0">
          <div class="reveal-up space-y-8">
            <h2 class="font-primary font-black text-[2rem] md:text-[3.5rem] lg:text-[4rem] leading-[0.95] uppercase tracking-tight text-[#0D0D0D]">
              Bridging the gap between <span class="text-[#0004ff] font-thin italic lowercase tracking-tight">strategic identity</span> and expressive motion.
            </h2>
            <p class="font-primary font-light text-lg md:text-xl text-[#6E6E6E] leading-relaxed max-w-[700px] tracking-wide pt-4 border-t-2 border-[#0D0D0D]">
              My practice is built on multidisciplinary exploration. I help both emerging and established brands communicate their core values through compelling, system-driven design solutions that leave a lasting impact.
            </p>
          </div>
        </article>
      </div>
    </section>

    <footer transition:name="site-footer" class="w-full bg-[#0D0D0D] px-5 md:px-10 py-10 md:py-12 border-t-4 border-[#0004ff]">
      <div class="max-w-[1800px] mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-6 font-primary text-[10px] md:text-xs uppercase tracking-[0.2em] text-[#888888]">
        <p class="m-0 font-semibold">© Curious Robert 2026</p>
        <p class="m-0 md:absolute md:left-1/2 md:-translate-x-1/2 font-bold text-[#F8F8F8]">Bucharest / Global</p>
        <!-- Added w-fit to prevent horizontal stretch -->
        <a href="mailto:curiousrobertmail@gmail.com" class="text-[#F8F8F8] hover:text-[#0004ff] transition-colors font-black flex items-center gap-2 no-underline w-fit">
          Say Hello <span class="text-sm font-light group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </footer>
  </main>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { 
      threshold: 0.05, 
      rootMargin: "0px 0px -50px 0px" 
    });

    setTimeout(() => {
      document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
    }, 50);
  });
</script>