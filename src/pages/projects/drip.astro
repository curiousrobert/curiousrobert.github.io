---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="drip soda project 2">
  
  <nav class="w-full px-5 md:px-10 py-5 flex flex-col md:flex-row justify-between items-start md:items-center bg-[#F8F8F8]/90 backdrop-blur-md sticky top-0 z-50 border-b-2 border-[#0D0D0D] gap-5 md:gap-0">
    <div class="flex items-center w-full md:w-auto">
      <div class="w-fit block">
        <a href="/">
          <img src="/favicon.svg" alt="curiousrobert logo" class="w-20 h-20 md:w-28 md:h-28 object-contain hover:opacity-50 transition-opacity" />
        </a>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 md:gap-12 font-primary text-[10px] md:text-[11px] font-bold tracking-[0.15em] uppercase w-full md:w-auto justify-start md:justify-end items-center">
      <!-- 1. "Home" is now the active button with the brutalist blue shadow effect -->
      <a href="/" class="text-[#F8F8F8] bg-[#0004ff] px-3 py-1.5 border-2 border-[#0D0D0D] shadow-[2px_2px_0px_0px_#0D0D0D] hover:translate-y-[2px] hover:shadow-none transition-all no-underline w-fit block">Home</a>
      
      <!-- 2. "Info" is renamed to "About" with transparent borders to stop jumping -->
      <a href="/about" class="text-[#0D0D0D] hover:text-[#0004ff] px-3 py-1.5 border-2 border-transparent transition-colors no-underline w-fit block">About</a>
      
      <a href="mailto:curiousrobertmail@gmail.com" class="text-[#0D0D0D] hover:text-[#0004ff] px-3 py-1.5 border-2 border-transparent transition-colors no-underline w-fit block">Contact</a>
    </div>
  </nav>

  <main class="w-full pb-0 bg-transparent">
    
    <header class="px-5 md:px-10 max-w-[1800px] mx-auto pt-16 md:pt-32 mb-12 md:mb-16 flex flex-col md:flex-row justify-between items-start md:items-end gap-8 border-b-2 border-[#0D0D0D] pb-12 md:pb-16">
      <div class="font-primary text-[#0D0D0D] max-w-2xl reveal-up">
        <h1 class="text-2xl md:text-4xl lg:text-5xl font-black uppercase tracking-tight leading-[1.1] mb-4">
          Drip <span class="text-[#0004ff] font-thin italic lowercase tracking-normal">Soda</span>
        </h1>
        <p class="text-xs md:text-sm font-semibold uppercase tracking-[0.15em] text-[#6E6E6E] border-l-2 border-[#0004ff] pl-4 w-fit">
          Brand & Motion <br/> 2026
        </p>
      </div>

      <div class="reveal-up" style="transition-delay: 100ms;">
        <span class="inline-block bg-[#0D0D0D] text-[#F8F8F8] font-primary font-black text-[10px] md:text-[11px] uppercase tracking-[0.2em] px-4 py-2 border-2 border-[#0D0D0D] shadow-[4px_4px_0px_0px_#0004ff]">
          Project 02
        </span>
      </div>
    </header>

    <section class="px-5 md:px-10 max-w-[1800px] mx-auto mb-20 md:mb-32 reveal-up">
      <div class="w-full aspect-[4/3] md:aspect-[21/9] overflow-hidden bg-[#e0e0e0] border-2 border-[#0D0D0D] shadow-[8px_8px_0px_0px_#0D0D0D]">
        <video autoplay muted loop playsinline class="w-full h-full object-cover">
          <source src="/videos/drip-video-5.mp4" type="video/mp4">
        </video>
      </div>
    </section>

    <section class="px-5 md:px-10 max-w-[1600px] mx-auto mb-20 md:mb-32 reveal-up">
      <div class="border-l-4 border-[#0004ff] pl-5 md:pl-8 py-2">
        <h2 class="font-primary font-black text-[1.75rem] md:text-[3rem] lg:text-[4rem] leading-[1.05] tracking-tight text-[#0D0D0D] uppercase max-w-5xl">
          Motion follows <span class="text-[#0004ff] font-thin italic lowercase tracking-normal">mechanical easing</span> and carbonation.
        </h2>
      </div>
    </section>

    <section class="px-5 md:px-10 max-w-[1800px] mx-auto pb-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
        
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-32 flex flex-col gap-10 md:gap-14 pb-12 border-t-2 border-[#0D0D0D] pt-8">
            
            <div class="reveal-up">
              <h3 class="inline-block bg-[#F8F8F8] text-[#0D0D0D] font-primary font-black text-[10px] md:text-[11px] uppercase tracking-[0.2em] px-2 py-1 border border-[#0D0D0D] mb-4">The Brief</h3>
              <p class="font-primary text-sm md:text-base text-[#6E6E6E] leading-relaxed tracking-wide">
                Establish typography as a reactive liquid system. Motion must follow compression, inertia, and elastic release—behavior reflecting actual viscosity.
              </p>
            </div>

            <div class="reveal-up">
              <h3 class="inline-block bg-[#F8F8F8] text-[#0D0D0D] font-primary font-black text-[10px] md:text-[11px] uppercase tracking-[0.2em] px-2 py-1 border border-[#0D0D0D] mb-4">Tech Stack</h3>
              <ul class="font-primary font-semibold text-[11px] md:text-xs text-[#0D0D0D] space-y-2 uppercase tracking-[0.15em]">
                <li class="border-b border-[#0D0D0D]/10 pb-1">Figma & Illustrator</li>
                <li class="border-b border-[#0D0D0D]/10 pb-1">After Effects</li>
                <li class="border-b border-[#0D0D0D]/10 pb-1">Cavalry</li>
                <li class="border-b border-[#0D0D0D]/10 pb-1">Ableton Live</li>
              </ul>
            </div>

            <div class="reveal-up space-y-8">
              <div>
                <h3 class="inline-block bg-[#F8F8F8] text-[#0D0D0D] font-primary font-black text-[10px] md:text-[11px] uppercase tracking-[0.2em] px-2 py-1 border border-[#0D0D0D] mb-4">Typography</h3>
                <div class="font-primary font-light text-sm uppercase tracking-widest text-[#0D0D0D]">Space Mono</div>
              </div>

              <div>
                <h3 class="inline-block bg-[#F8F8F8] text-[#0D0D0D] font-primary font-black text-[10px] md:text-[11px] uppercase tracking-[0.2em] px-2 py-1 border border-[#0D0D0D] mb-4">Palette</h3>
                <div class="flex gap-3">
                  <div class="w-8 h-8 bg-[#F8A003] border-2 border-[#0D0D0D] shadow-[2px_2px_0px_0px_#0D0D0D]"></div>
                  <div class="w-8 h-8 bg-[#739700] border-2 border-[#0D0D0D] shadow-[2px_2px_0px_0px_#0D0D0D]"></div>
                  <div class="w-8 h-8 bg-[#120F03] border-2 border-[#0D0D0D] shadow-[2px_2px_0px_0px_#0D0D0D]"></div>
                  <div class="w-8 h-8 bg-[#E8EBDC] border-2 border-[#0D0D0D] shadow-[2px_2px_0px_0px_#0D0D0D]"></div>
                  <div class="w-8 h-8 bg-[#FDB918] border-2 border-[#0D0D0D] shadow-[2px_2px_0px_0px_#0D0D0D]"></div>
                </div>
              </div>
            </div>

          </div>
        </aside>

        <article class="lg:col-span-8 space-y-12 md:space-y-20">
          
          <div class="reveal-up overflow-hidden bg-[#e0e0e0] border-2 border-[#0D0D0D]">
            <video autoplay muted loop playsinline class="w-full h-auto block">
              <source src="/videos/drip-video-1.mp4" type="video/mp4">
            </video>
          </div>

          <div class="reveal-up bg-[#0D0D0D] text-[#F8F8F8] p-6 md:p-10 border-2 border-[#0D0D0D] shadow-[6px_6px_0px_0px_#0004ff]">
             <p class="font-primary font-light text-lg md:text-xl leading-snug tracking-wide">
               By blending high-contrast palettes with snappy, elastic motion, the identity system feels simultaneously highly structured and refreshingly chaotic.
             </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-center">
            <div class="md:col-span-5 reveal-up overflow-hidden bg-[#e0e0e0] border-2 border-[#0D0D0D]">
              <video autoplay muted loop playsinline class="w-full h-auto block">
                <source src="/videos/drip-video-2.mp4" type="video/mp4">
              </video>
            </div>
            <div class="md:col-span-7 reveal-up overflow-hidden bg-[#e0e0e0] border-2 border-[#0D0D0D]">
              <video autoplay muted loop playsinline class="w-full h-auto block">
                <source src="/videos/drip-video-3.mov" type="video/mp4">
              </video>
            </div>
          </div>

          <div class="reveal-up overflow-hidden bg-[#e0e0e0] border-2 border-[#0D0D0D]">
            <video autoplay muted loop playsinline class="w-full h-auto block">
              <source src="/videos/drip-video-4.mp4" type="video/mp4">
            </video>
          </div>

        </article>
      </div>
    </section>

    <footer class="w-full bg-[#0D0D0D] px-5 md:px-10 py-10 md:py-12 border-t-4 border-[#0004ff]">
      <div class="max-w-[1800px] mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-6 font-primary text-[10px] md:text-xs uppercase tracking-[0.2em] text-[#888888]">
        <p class="m-0 font-semibold">© Curious Robert 2026</p>
        <p class="m-0 md:absolute md:left-1/2 md:-translate-x-1/2 font-bold text-[#F8F8F8]">Bucharest / Global</p>
        <a href="/projects/semn" class="bg-transparent border-none text-[#F8F8F8] hover:text-[#0004ff] transition-colors cursor-pointer font-primary p-0 text-[10px] md:text-xs uppercase tracking-[0.2em] font-black flex items-center gap-2 group w-fit no-underline">
          Next Project <span class="text-sm font-light group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </footer>
  </main>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { 
      threshold: 0.05, 
      rootMargin: "0px 0px -50px 0px" 
    });

    setTimeout(() => {
      document.querySelectorAll('.reveal-up:not(.is-visible)').forEach((el) => observer.observe(el));
    }, 50);
  });
</script>