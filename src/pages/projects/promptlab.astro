---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Project Detail — curiousrobert">
  
  <nav class="fixed top-0 w-full z-50 px-6 py-6 md:px-12 md:py-8 flex flex-col items-start gap-4 md:flex-row md:justify-between md:items-start mix-blend-difference text-[#F2F2F2]">
    <div class="flex flex-col">
      <a href="/" class="text-2xl font-black tracking-widest leading-none hover:opacity-50 transition">
        curiousrobert<br/>
      </a>
      <span class="font-mono text-[10px] mt-2 opacity-60 hidden md:block">
        2026 // Bucharest
      </span>
    </div>

    <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[10px] sm:text-xs font-bold tracking-widest uppercase pointer-events-auto">
      <a href="/" class="opacity-50 hover:opacity-100 transition-opacity">Home</a>
      <a href="/about" class="opacity-50 hover:opacity-100 transition-opacity">About</a>
      <a href="mailto:curiousrobertmail@gmail.com" class="opacity-50 hover:opacity-100 transition-opacity">Contact</a>
    </div>
  </nav>

  <main class="w-full pt-36 md:pt-48 pb-12">
    <header class="px-6 md:px-12 max-w-[1800px] mx-auto mb-20">
        <h1 class="text-[12vw] md:text-[8vw] leading-[0.8] font-[900] italic uppercase tracking-tighter text-black reveal-up">
            promptlab
        </h1>
        <div class="mt-8 border-t border-black pt-4 flex flex-col gap-2 md:flex-row md:justify-between md:items-center font-mono text-[10px] uppercase tracking-widest opacity-60 reveal-up">
            <span>Project 02</span>
            <span>Brand & Motion Design 2025</span>
        </div>
    </header>

    <section class="px-6 md:px-12 max-w-[1800px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24">
        
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32 space-y-12">
            
            <div class="reveal-up">
              <h3 class="font-mono text-[10px] uppercase tracking-widest mb-4 opacity-40">Project Overview</h3>
              <p class="text-xl md:text-2xl font-medium leading-tight">
                I wanted to create a dynamic motion and audio design project for promptlab.io, a platform dedicated to AI prompt engineering. 
              </p>
            </div>

            <div class="reveal-up space-y-6">
              <p class="text-gray-600 leading-relaxed">
               The <strong>goal</strong> is to visually represent the innovative and cutting-edge nature of AI technology through engaging animations and soundscapes.
              </p>
              
              <div class="pt-6 border-t border-black/10">
                <h4 class="font-mono text-[10px] uppercase tracking-widest mb-3 opacity-40">Tool Stack</h4>
                <ul class="font-mono text-xs uppercase space-y-1 tracking-wider">
                  <li>Figma / Illustrator</li>
                  <li>After Effects / DaVinci Resolve</li>
                  <li>Cavalry / Ableton</li>
                </ul>
              </div>
            </div>

          </div>
        </div>

        <div class="lg:col-span-8 space-y-12 md:space-y-32">
          
          <div class="reveal-up group overflow-hidden border border-black bg-white">
            <video autoplay muted loop playsinline class="w-full h-auto scale-[1.01]">
              <source src="/videos/promptlab-video-1.mp4" type="video/mp4">
            </video>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="reveal-up group overflow-hidden border border-black bg-white">
            <video autoplay muted loop playsinline class="w-full h-auto">
              <source src="/videos/promptlab-video-2.mp4" type="video/mp4">
            </video>
            </div>
           
            <div class="reveal-up group overflow-hidden border border-black bg-white">
            <video autoplay muted loop playsinline class="w-full h-auto">
              <source src="/videos/promptlab-video-4.mp4" type="video/mp4">
            </video>
            </div>
          </div>

          <div class="reveal-up border border-black bg-black">
            <video autoplay controls muted loop playsinline class="w-full h-auto mx-auto">
              <source src="/videos/promptlab-video-3.mp4" type="video/mp4">
            </video>
          </div>

          <div class="reveal-up group overflow-hidden">
            <video autoplay muted loop playsinline class="w-full max-w-3xl h-auto mx-auto block border border-black">
              <source src="/videos/promptlab-video-5.mp4" type="video/mp4">
            </video>
          </div>

        </div>
      </div>
    </section>

    <footer class="mt-24 md:mt-48 px-6 md:px-12 py-12 border-t border-black/10 reveal-up">
        <div class="flex flex-col md:flex-row justify-between items-center font-mono text-[10px] uppercase tracking-widest text-gray-500">
         <p>© Curious Robert 2026</p>
         <p>Bucharest / Romania</p>
         <a href="/projects/semn" class="hover:text-black transition">Next Project</a>
       </div>
     </footer>
  </main>
</Layout>

<style>
  /* These classes hook into the script below */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .reveal-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
</script>
