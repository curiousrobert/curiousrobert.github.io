---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Project Detail — curiousrobert">
  
  <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
  
  <nav class="w-full px-6 py-6 md:px-12 md:py-8 flex flex-col items-start gap-4 md:flex-row md:justify-between md:items-start mix-blend-difference text-[#F2F2F2]">
    <div class="flex flex-col">
      <a href="/" class="text-2xl font-normal tracking-widest leading-none hover:opacity-50 transition">
        curiousrobert<br/>
      </a>
      <span class="font-mono text-[10px] mt-2 opacity-60 hidden md:block">
        2026 // Bucharest
      </span>
    </div>

    <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[10px] sm:text-xs font-bold tracking-widest uppercase pointer-events-auto">
      <a href="/" class="opacity-50 hover:opacity-100 transition-opacity">Home</a>
      <a href="/about" class="opacity-50 hover:opacity-100 transition-opacity">About</a>
      <a href="mailto:curiousrobertmail@gmail.com" class="opacity-50 hover:opacity-100 transition-opacity">Contact</a>
    </div>
  </nav>

  <main class="w-full pt-12 md:pt-16 pb-12">
    <header class="px-6 md:px-12 max-w-[1800px] mx-auto mb-20">
        <h1 class="text-[12vw] md:text-[8vw] leading-[0.8] font-normal italic uppercase tracking-tighter text-black reveal-up">
            visit bucharest
        </h1>
        <div class="mt-8 border-t border-black pt-4 flex flex-col gap-2 md:flex-row md:justify-between md:items-center font-mono text-[10px] uppercase tracking-widest opacity-60 reveal-up">
            <span>Project 04</span>
            <span>Web & Motion Design 2026</span>
        </div>
    </header>

    <section class="px-6 md:px-12 max-w-[1800px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24">
        
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-32 space-y-12">
            
            <div class="reveal-up">
              <h3 class="font-mono text-[10px] uppercase tracking-widest mb-4 opacity-40">Project Overview</h3>
              <p class="text-xl md:text-2xl font-normal leading-tight">
                Bucharest is a city defined by contrast between historic rigidity and modern chaos.
              </p>
            </div>

            <div class="reveal-up space-y-6">
              <p class="text-black-600 leading-relaxed">
               <strong>Idea:</strong> Create a system that reflects the dynamic energy of the city through motion and visual storytelling.
              </p>

              <p class="text-black-600 leading-relaxed">
               <strong>Translation:</strong> Typography shifts between structured grids and disruptive motion.
              </p>
              
              <p class="text-gray-600 leading-relaxed">
               <strong>Direction and constraints:</strong> Design a web experience that captures the essence of Bucharest's duality, using motion to evoke emotion while maintaining usability and accessibility.
              </p>
              
              
              <div class="pt-6 border-t border-black/10">
                <h4 class="font-mono text-[10px] uppercase tracking-widest mb-3 opacity-40">Tool Stack</h4>
                <ul class="font-mono text-xs uppercase space-y-1 tracking-wider">
                  <li>Jitter / Cavalry</li>
                  <li>After Effects</li>
                  <li>HTML / CSS / JavaScript</li>
                </ul>
              </div>
            </div>

            <div class="pt-6 border-t border-black/10">
            <h4 class="font-mono text-[10px] uppercase tracking-widest mb-6 opacity-40">
              Design System
            </h4>

            <!-- Typography -->
            <div class="mb-8">
              <h5 class="font-mono text-[10px] uppercase tracking-widest mb-3 opacity-40">
                Typography
              </h5>

              <ul class="space-y-4">
                <li>
                  <div class="text-lg leading-tight">Lexand Peta Black</div>
                  <div class="font-mono text-[10px] uppercase tracking-wider opacity-50">
                    Primary — Headlines & Motion
                  </div>
                </li>

                <li>
                  <div class="text-sm font-mono uppercase tracking-widest">
                    Inter
                  </div>
                  <div class="font-mono text-[10px] uppercase tracking-wider opacity-50">
                    Secondary — UI & Interface
                  </div>
                </li>
              </ul>
            </div>

            <!-- Color -->
            <div>
              <h5 class="font-mono text-[10px] uppercase tracking-widest mb-3 opacity-40">
                Color
              </h5>

              <div class="space-y-4">

                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-[#FF9234] border border-black/100"></div>
                    <span class="font-mono text-xs uppercase tracking-wider">Orange</span>
                  </div>
                  <span class="font-mono text-[10px] opacity-50">#FF9234</span>
                </div>

                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-[#404040] border border-black/100"></div>
                    <span class="font-mono text-xs uppercase tracking-wider">Black</span>
                  </div>
                  <span class="font-mono text-[10px] opacity-50">#404040</span>
                </div>

                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-[#f9faf1] border border-black/100"></div>
                    <span class="font-mono text-xs uppercase tracking-wider">Off White</span>
                  </div>
                  <span class="font-mono text-[10px] opacity-50">#f9faf1</span>
                </div>

              </div>
            </div>
</div>

          </div>
        </div>

        <div class="lg:col-span-8 space-y-12 md:space-y-32">
          
           <div class="reveal-up p-6 md:p-12">
            <lottie-player 
              src="/animations/visit-bucharest-2.json" 
              background="transparent" 
              speed="1" 
              loop 
              autoplay
              class="w-full h-auto">
            </lottie-player>
          </div>
          
          <div class="reveal-up group overflow-hidden border border-black bg-white">
            <video autoplay muted loop playsinline class="w-full h-full object-cover scale-[1.01]">
              <source src="/videos/visit-bucharest.mp4" type="video/mp4">
            </video>
          </div>

          <div class="reveal-up p-6 md:p-12">
            <lottie-player 
              src="/animations/visit-bucharest-1.json" 
              background="transparent" 
              speed="1" 
              loop 
              autoplay
              class="w-full h-auto">
            </lottie-player>
          </div>

        </div>
      </div>
    </section>

    <footer class="mt-24 md:mt-48 px-6 md:px-12 py-12 border-t border-black/10 reveal-up">
        <div class="flex flex-col md:flex-row justify-between items-center font-mono text-[10px] uppercase tracking-widest text-gray-500">
         <p>© Curious Robert 2026</p>
         <p>Bucharest / Romania</p>
         <a href="/projects/promptlab" class="hover:text-black transition">Next Project</a>
       </div>
     </footer>
  </main>
</Layout>

<style>
  /* These classes hook into the script below */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .reveal-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal-up').forEach((el) => observer.observe(el));
</script>
