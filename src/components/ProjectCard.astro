---
interface Props {
  title: string;
  category: string;
  year: string;
  videoSrc: string;
  href: string;
  className?: string; // Allow custom spacing
}

const { title, category, year, videoSrc, href, className } = Astro.props;
---

<a href={href} class={`group block relative ${className}`}>
  <div class="relative w-full aspect-[4/5] md:aspect-square overflow-hidden rounded-none md:rounded-2xl transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] group-hover:rounded-none">
    
    <video 
      src={videoSrc}
      autoplay 
      muted 
      loop 
      playsinline 
      class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105"
    ></video>

    <div class="absolute inset-0 bg-black/10 opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
    
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-all duration-500 transform translate-y-4 group-hover:translate-y-0">
      <div class="bg-white/90 backdrop-blur-sm px-6 py-2 rounded-full">
        <span class="font-mono text-xs font-bold uppercase tracking-widest text-black">View Case</span>
      </div>
    </div>
  </div>

  <div class="mt-4 border-t border-black/10 pt-3 flex justify-between items-start group-hover:border-black transition-colors duration-500">
    <div>
      <h3 class="text-3xl font-black tracking-tighter uppercase leading-[0.9]">{title}</h3>
      <div class="flex gap-2 mt-2">
        <span class="font-mono text-[10px] uppercase tracking-wider text-gray-500 border border-gray-300 px-1.5 py-0.5 rounded-sm group-hover:border-black group-hover:text-black transition-colors">
          {category}
        </span>
      </div>
    </div>
    <span class="font-mono text-xs font-bold text-gray-400 group-hover:text-black transition-colors">
      ( {year} )
    </span>
  </div>
</a>